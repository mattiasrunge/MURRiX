{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 175,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "@db/mongo": "jsr:@db/mongo@0.33.0",
    "@oak/oak": "jsr:@oak/oak@16.1.0",
    "@patternfly/react-charts": "npm:/@patternfly/react-charts@alpha",
    "@patternfly/react-core": "npm:@patternfly/react-core@alpha",
    "@patternfly/react-icons": "npm:@patternfly/react-icons@alpha",
    "@patternfly/react-styles": "npm:@patternfly/react-styles@alpha",
    "@patternfly/react-table": "npm:@patternfly/react-table@alpha",
    "@patternfly/react-tokens": "npm:@patternfly/react-tokens@alpha",
    "@preact/signals-react": "npm:@preact/signals-react@^2.0.2",
    "@std/assert": "jsr:@std/assert@0.226.0",
    "@std/crypto": "jsr:@std/crypto@0.224.0",
    "@std/encoding": "jsr:@std/encoding@0.224.3",
    "@std/fs": "jsr:@std/fs@0.229.3",
    "@std/path": "jsr:@std/path@0.225.2",
    "@std/testing": "jsr:@std/testing@0.225.3",
    "@tus/file-store": "npm:@tus/file-store@1.2.0",
    "@tus/server": "npm:@tus/server@1.6.0",
    "@tus/utils": "npm:@tus/utils@0.2.0",
    "@types/react": "npm:@types/react@18.3.1",
    "@ui/components": "./src/modules/ui/client/components/mod.ts",
    "@ui/lib": "./src/modules/ui/client/lib/mod.ts",
    "@ui/signals": "./src/modules/ui/client/signals/mod.ts",
    "amqp": "https://deno.land/x/amqp@v0.24.0/mod.ts",
    "edtf": "npm:edtf@4.6.0",
    "esbuild": "https://deno.land/x/esbuild@v0.21.5/mod.js",
    "esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.10.3",
    "esbuild-plugin-any-file": "npm:@chialab/esbuild-plugin-any-file@0.18.0",
    "esbuild-plugin-gzip": "npm:@luncheon/esbuild-plugin-gzip@0.1.0",
    "file-selector": "npm:file-selector@^0.6.0/dist/bundles/file-selector.umd.js",
    "jsx-runtime": "npm:jsx-runtime@1.2.0",
    "moment-timezone": "npm:moment-timezone@0.5.44",
    "oakCors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "react": "npm:react@18.3.1",
    "react-dom": "npm:react-dom@18.3.1",
    "react-router-dom": "npm:/react-router-dom@6.24.0",
    "redis": "https://deno.land/x/redis@v0.32.3/mod.ts",
    "scrypt": "https://deno.land/x/scrypt@v4.4.4/mod.ts",
    "tslib": "npm:tslib@^2.6.3/tslib.es6.mjs",
    "~/": "./"
  },
  "tasks": {
    "test": "rm -rf coverage && deno test --trace-ops -A --coverage=coverage && deno coverage --lcov coverage --output=coverage/coverage.lcov && genhtml -o coverage/html coverage/coverage.lcov",
    "dev": "deno run -A src/main.ts ./config.dev.json",
    "bundle-ui": "deno run -A src/modules/ui/bundle.ts"
  }
}
