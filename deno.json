{
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 175,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "~/": "./",
    "std/": "https://deno.land/std@0.210.0/",
    "mongo": "https://deno.land/x/mongo@v0.32.0/mod.ts",
    "redis": "https://deno.land/x/redis@v0.32.1/mod.ts",
    "amqp": "https://deno.land/x/amqp@v0.23.1/mod.ts",
    "scrypt": "https://deno.land/x/scrypt@v4.3.1/mod.ts",
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "oakCors": "https://deno.land/x/cors@v1.2.2/mod.ts",
    "@tus/server": "npm:@tus/server@1.3.0",
    "@tus/file-store": "npm:@tus/file-store@1.1.0"
  },
  "tasks": {
    "test": "rm -rf coverage && deno test --trace-ops -A --coverage=coverage && deno coverage --lcov coverage --output=coverage/coverage.lcov && genhtml -o coverage/html coverage/coverage.lcov",
    "dev": "deno run -A src/main.ts ./config.dev.json"
  }
}