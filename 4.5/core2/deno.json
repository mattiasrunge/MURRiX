{
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 175,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "imports": {
    "~/": "./",
    "std/": "https://deno.land/std@0.210.0/",
    "mongo": "https://deno.land/x/mongo@v0.32.0/mod.ts",
    "redis": "https://deno.land/x/redis@v0.32.1/mod.ts",
    "amqp": "https://deno.land/x/amqp@v0.23.1/mod.ts",
    "scrypt": "https://deno.land/x/scrypt@v4.3.1/mod.ts",
    "event": "https://deno.land/x/event@2.0.1/mod.ts"
  },
  "tasks": {
    "test": "rm -rf coverage && deno test -A --coverage=coverage && deno coverage --lcov coverage --output=coverage/coverage.lcov && genhtml -o coverage/html coverage/coverage.lcov",
    "dev": "deno run -A src/index.ts",
    "start": "deno run --lock=deno.lock --cached-only -A src/index.ts production",
    "cache": "deno cache --reload --lock=deno.lock src/index.ts"
  }
}